{
  "agentController": {
    "workerId": "example-worker",
    "pollIntervalSeconds": 30,
    "maxConcurrentRuns": 3,
    "staleTimeoutSeconds": 1800,
    "runRoot": "~/.agent-work-controller/runs",
    "retainSuccessfulRuns": true,
    "retainFailedRuns": true
  },
  "persistence": {
    "provider": "Sqlite",
    "connectionString": "Data Source=~/.agent-work-controller/agent-controller.db"
  },
  "workSource": {
    // Provider: "AzureDevOpsBoards" to poll an Azure DevOps board, or "LocalFake" for offline testing.
    "provider": "AzureDevOpsBoards",

    // Azure DevOps organization URL (replace YOUR_ORG with your org name).
    "organizationUrl": "https://dev.azure.com/YOUR_ORG",

    // Azure DevOps project name within the organization.
    "project": "YOUR_PROJECT",

    // Prefix for controller-owned board tags. The default "agent" produces
    // agent-ready, agent-ready-rework, agent-active, agent-failed, and
    // agent-needs-human. Managed work-source environment profiles are
    // authoritative for live ADO environments.
    "tagPrefix": "agent",

    // Tags that mark a work item as eligible for agent pickup.
    "eligibleTags": [
      "agent-ready"
    ],

    // Tags that exclude a work item from discovery.
    // Defaults: ["agent-active", "agent-failed", "agent-needs-human"]
    // These prevent re-pickup of items the controller has already claimed,
    // failed, or marked as needing human input. Items can be retried by
    // removing the exclusion tag from the work item in Azure DevOps.
    // Add custom exclusion tags here (e.g. "agent-blocked" to manually block items).
    "excludedTags": [
      "agent-active",
      "agent-failed",
      "agent-needs-human",
      "agent-blocked"
    ],

    // Board states considered eligible for polling (must match your process template).
    "eligibleStates": [
      "New"
    ],

    // State the poller transitions a work item to when an agent begins execution.
    "activeState": "Active",

    // State the poller transitions a work item to when execution completes successfully.
    "completedState": "Resolved",

    // Azure DevOps work item type for state validation (default: "User Story").
    // Used at startup to enumerate valid System.State values and validate
    // that activeState, completedState, and eligibleStates are all valid.
    // Common values: "User Story", "Task", "Bug".
    // "workItemType": "User Story"
  },
  "azureDevOps": {
    // Personal Access Token.
    // New-work board handling needs "Work Items: Read & write". Repository-wide
    // Assistance also needs "Code: Read & write" for PR discovery, threads,
    // labels/comments, and existing-branch work.
    "personalAccessToken": "YOUR_PAT_HERE"
  },
  "sourceControl": {
    "provider": "LocalGit"
  },
  "environmentProvider": {
    "provider": "LocalWorkspace"
  },
  "runtime": {
    // Use "MockPiMateria" for simulated local runs (no pi installation needed).
    // Use "PiMateria" to launch `pi` as a detached CLI process that drives
    // a pi-materia cast; runtime events flow back over HTTP to the controller's
    // POST /runs/{runId}/events endpoint (see docs/arch.md §13b).
    //
    // PiMateria requires:
    //   - controllerBaseUrl: this controller's HTTP origin (e.g. http://localhost:5103)
    //     so pi-materia can POST runtime.* events back here.
    //   - piExecutablePath: path to `pi` (default "pi", resolved via PATH).
    //
    // Example PiMateria block:
    //   "provider": "PiMateria",
    //   "controllerBaseUrl": "http://localhost:5103",
    //   "piExecutablePath": "pi"
    //
    // PTY wrapper (Linux only, util-linux):
    //   "ptyWrapperPath": "script",
    //   "ptyWrapperArgs": "-qfc"
    //
    // Environment variable forwarding: target→source map. Each key is the
    // variable name set on the pi child; each value is the name to read from
    // the controller's own process environment. Entries whose source is unset
    // or empty are silently skipped. Default entries forward AZURE_DEVOPS_PAT
    // to both AZURE_DEVOPS_EXT_PAT (az extension auth) and AZURE_DEVOPS_PAT
    // on the child. Override here to change the map:
    //   "forwardEnvironmentVariables": {
    //     "AZURE_DEVOPS_EXT_PAT": "AZURE_DEVOPS_PAT",
    //     "AZURE_DEVOPS_PAT": "AZURE_DEVOPS_PAT"
    //   }
    "provider": "MockPiMateria",
    "piExecutablePath": "pi",
    // Loadout map: ExecutionKind → pi-materia loadout name.
    // NewWork handles ordinary <prefix>-ready stories and may create a new branch/PR.
    // Rework handles both original-story Revival and new-story Assistance: it checks
    // out and updates the existing PR branch and must not open another PR.
    // Override here to use custom loadouts for different execution types:
    //   "loadouts": {
    //     "NewWork": "ADO-Build-NewWork",
    //     "Rework": "ADO-Build-Rework"
    //   }
  },
  // Repository, runtime-environment, work-source environment, connection, and secret
  // profiles are managed through the Web UI/API and persisted in the controller database.
  // Static repository profiles in appsettings are not loaded.
  "localWork": {
    "definitions": [
      {
        "externalId": "local-task-1",
        "repoKey": "example-service",
        "title": "Add retry handling for transient failures",
        "body": "The service should retry transient HTTP 5xx responses up to 3 times with exponential backoff.",
        "acceptanceCriteria": {
          "given": "A service call receives a 503 response",
          "when": "The retry middleware is configured",
          "then": "The call is retried up to 3 times with exponential backoff"
        },
        "priority": 1,
        "status": "New",
        "tags": [
          "agent-ready",
          "enhancement"
        ]
      },
      {
        "repoKey": "example-service",
        "title": "Add health check endpoint",
        "body": "Add a /health endpoint that returns 200 when the service is healthy.",
        "tags": [
          "agent-ready",
          "feature"
        ]
      }
    ]
  },
  "feedback": {
    // Provider: "AzureDevOpsRepos" to poll ADO PR comments, "Local" for local testing, or "None" to disable.
    "provider": "AzureDevOpsRepos",

    // Enable the feedback polling worker. When false the worker sleeps indefinitely.
    "enabled": true,

    // How often to poll for review comments (seconds). Default: 60.
    "pollIntervalSeconds": 60,

    // Maximum concurrent feedback poll operations. Default: 2.
    "maxConcurrentPolls": 2,

    // Minutes since last qualifying comment before feedback is "soaked" and eligible for materialization. Default: 5.
    "soakMinutes": 5,

    // PR label that requests the existing original-story Revival workflow. Revival
    // is run-backed, requires qualifying feedback, and reactivates the prior story.
    // Default: "agent-rework-requested".
    "reworkMarkerTag": "agent-rework-requested",

    // PR label that requests Assistance. Assistance scans every managed ADO repo,
    // supports human-submitted PRs and zero-comment cleanup, and creates a fresh
    // story with <prefix>-ready-rework. If both markers exist, Assistance wins.
    // Default: "agent-assistance-requested".
    "assistanceMarkerTag": "agent-assistance-requested",

    // Added only after runtime.accepted for Assistance. Success clears request,
    // in-progress, and a conflicting Revival marker; failure/needs-human/cancel
    // clear only in-progress and retain the Assistance request. Assistance label
    // names must be nonempty, and all three names must be distinct case-insensitively.
    // Default: "agent-assistance-in-progress".
    "assistanceInProgressTag": "agent-assistance-in-progress",

    // Maximum review threads to bundle per rework cycle. Default: 50.
    "maxReviewThreadsPerBundle": 50
  }
}
